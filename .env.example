PRAGENT_HOST=127.0.0.1
PRAGENT_PORT=8080
PRAGENT_DB_PATH=pragent.db
PRAGENT_MAX_DIFF_BYTES=1048576
PRAGENT_MAX_STEPS=8
PRAGENT_TIMEOUT_SECONDS=120

# Login is disabled by default for local use. Enable it before exposing the service.
PRAGENT_AUTH_REQUIRED=false
PRAGENT_AUTH_SECRET=
PRAGENT_BOOTSTRAP_ADMIN_USERNAME=
PRAGENT_BOOTSTRAP_ADMIN_PASSWORD=
PRAGENT_DEFAULT_TENANT_ID=default
PRAGENT_SESSION_TTL_SECONDS=3600

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local keeps the deterministic rule-only reviewer.
PRAGENT_LLM_PROVIDER=local

PRAGENT_ENABLED_AGENTS=lead,security,correctness-reliability,critic
# Per-role cumulative budget. Reasoning models spend part of it on the thinking
# trace and on the recovery retries, so 24000 or more is realistic with
# deepseek-flash; 8000 is only enough for a non-reasoning provider.
PRAGENT_AGENT_TOKEN_BUDGET=8000
PRAGENT_AGENT_TIME_BUDGET_SECONDS=60
# Hard ceiling for one whole review across every role, retry and rework round.
# 0 derives it from the per-role budget above (tokens x6, seconds x4) and leaves
# the model-call count unbounded. Set explicit values to cap the cost of a review.
PRAGENT_AGENT_REVIEW_TOKEN_BUDGET=0
PRAGENT_AGENT_REVIEW_TIME_BUDGET_SECONDS=0
PRAGENT_AGENT_REVIEW_MAX_MODEL_CALLS=0
# Preflight semantic context budget. Keep input + output below the model window.
PRAGENT_AGENT_CONTEXT_WINDOW_TOKENS=32768
PRAGENT_AGENT_CONTEXT_INPUT_TOKENS=20000
PRAGENT_CONTEXT_DIFF_TOKEN_BUDGET=12000
PRAGENT_CONTEXT_OBSERVATION_TOKEN_BUDGET=4000
PRAGENT_CONTEXT_RECENT_OBSERVATIONS=2
PRAGENT_CONTEXT_MAP_CHUNK_TOKENS=3000
# Configure current provider pricing for non-zero cost accounting in reports.
PRAGENT_LLM_INPUT_COST_PER_MILLION=0
PRAGENT_LLM_OUTPUT_COST_PER_MILLION=0

# Official DeepSeek (paid API; model defaults to deepseek-v4-flash)
# Set PRAGENT_LLM_MODEL explicitly: deepseek-flash or deepseek-v4-pro.
PRAGENT_DEEPSEEK_API_KEY=

# Reasoning models spend completion budget on the thinking trace, which can
# starve the JSON answer. Empty values send no extra parameter.
# thinking: enabled | disabled ; reasoning_effort: low | medium | high | max
PRAGENT_LLM_THINKING=
PRAGENT_LLM_REASONING_EFFORT=
# Per-call output cap and per-role cumulative budget.
PRAGENT_AGENT_MAX_OUTPUT_TOKENS=4000

# OpenRouter free presets (API key required; low rate limits and availability may vary)
PRAGENT_OPENROUTER_API_KEY=
PRAGENT_OPENROUTER_SITE_URL=
PRAGENT_OPENROUTER_APP_NAME=PRAgent

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
PRAGENT_LLM_BASE_URL=
PRAGENT_LLM_API_KEY=
PRAGENT_LLM_MODEL=

# Replay evaluation and evolution activation gate
PRAGENT_EVAL_MAX_CASES=5
PRAGENT_EVAL_MIN_CASES=3
PRAGENT_EVAL_MIN_HOLDOUT_CASES=2
PRAGENT_EVAL_MIN_IMPROVEMENT=0.01
PRAGENT_EVAL_MAX_METRIC_REGRESSION=0
PRAGENT_EVALUATION_MIN_PUBLIC_PRS=300
PRAGENT_EVALUATION_MIN_F1_IMPROVEMENT=0.03
PRAGENT_EVALUATION_MIN_HIGH_RISK_IMPROVEMENT=0.05

# GitHub integration
PRAGENT_GITHUB_WEBHOOK_SECRET=
PRAGENT_GITHUB_TOKEN=
PRAGENT_AUTO_POST_REVIEW=false
PRAGENT_WEBHOOK_MAX_AGE_SECONDS=600

# Production persistence and queue. Leave blank for SQLite/in-process mode.
PRAGENT_DATABASE_URL=
PRAGENT_REDIS_URL=
PRAGENT_ASYNC_WORKERS=2
PRAGENT_QUEUE_MAX_ATTEMPTS=3
PRAGENT_QUEUE_LEASE_SECONDS=60
PRAGENT_SKILLS_DIR=skills

# Repair verification and observability
PRAGENT_REPAIR_TEST_COMMAND=
PRAGENT_REPAIR_VERIFY_TIMEOUT_SECONDS=120
PRAGENT_MEMORY_ENABLED=true
PRAGENT_MEMORY_RECALL_LIMIT=6
PRAGENT_MEMORY_WORKING_TTL_SECONDS=86400
PRAGENT_OTEL_ENDPOINT=
PRAGENT_OTEL_SERVICE_NAME=pragent
PRAGENT_ALERT_FAILURE_RATE=0.20
PRAGENT_ALERT_MIN_SAMPLES=10

# GitHub App (installation flow: /github/install, callback: /github/setup)
PRAGENT_GITHUB_APP_ID=
PRAGENT_GITHUB_APP_SLUG=
PRAGENT_GITHUB_PRIVATE_KEY_PATH=
PRAGENT_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Docker Compose only (ignored by `python -m pragent`).
# Host port mapping; keep PRAGENT_PUBLIC_BASE_URL in sync when you change it.
PRAGENT_HTTP_PORT=8080
# Postgres password for the bundled database container. Changing it after the
# first start requires removing the pragent_postgres_data volume.
PRAGENT_POSTGRES_PASSWORD=
# Build args: base image and pip index (mirror-friendly).
PYTHON_IMAGE=python:3.11-slim
PIP_INDEX_URL=https://pypi.org/simple

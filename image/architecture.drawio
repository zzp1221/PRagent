r=#EFF6FF;strokeColor=#648AC3;strokeWidth=1.5;fontColor=#163B69;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="380" width="330" height="140" as="geometry" /></mxCell><mxCell id="service" value="&lt;div style=&quot;text-align:center;line-height:1.5&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:19px&quot; color=&quot;#163B69&quot;&gt;ReviewService&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#46566E&quot;&gt;输入校验、任务创建、结果查询&lt;br&gt;同步执行 / 异步投递 / 取消与续跑&lt;br&gt;GitHub、修复、反馈与版本入口&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=17;fillColor=#EFF6FF;strokeColor=#648AC3;strokeWidth=1.5;fontColor=#163B69;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="450" y="380" width="410" height="140" as="geometry" /></mxCell><mxCell id="context" value="&lt;div style=&quot;text-align:center;line-height:1.5&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:18px&quot; color=&quot;#513B76&quot;&gt;ContextManager&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#46566E&quot;&gt;Diff 压缩 / 相关片段&lt;br&gt;观察摘要 / 上下文预算&lt;br&gt;分角色构建模型输入&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fillColor=#F4F0FF;strokeColor=#9C86C1;strokeWidth=1.5;fontColor=#513B76;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="930" y="380" width="290" height="140" as="geometry" /></mxCell><mxCell id="memory" value="&lt;div style=&quot;text-align:center;line-height:1.5&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:18px&quot; color=&quot;#513B76&quot;&gt;MemoryManager&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#46566E&quot;&gt;working / episodic&lt;br&gt;semantic · SQL 持久化&lt;br&gt;按租户、仓库检索与召回&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSp